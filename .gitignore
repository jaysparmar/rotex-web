# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts


#claude
.claude/*
/src/generated/prisma

# uploaded media (local dev storage)
/public/uploads/*
!/public/uploads/.gitkeep

# sqlite database
/prisma/dev.db
/prisma/dev.db-journal
/dev.db
/dev.db-journal


# zip
*.zip

# tinymce self-hosted assets (regenerated by postinstall)
/public/tinymce


/docs
# Staged zip uploads for the product image import
/.import-tmp/
/import-files/
